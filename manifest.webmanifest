{
  "id": "/",
  "name": "SupportDesk Live",
  "short_name": "SupportDesk",
  "description": "Customer support and secure conversations",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#063B46",
